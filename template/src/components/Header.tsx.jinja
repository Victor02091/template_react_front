import { Link, useLocation } from "react-router-dom";
{% if use_oidc %}
import { AuthBadge } from "@/components/AuthBadge";
{% endif %}

const NAV_ITEMS = [{ to: "/", label: "Home" }];

export function Header() {
  const location = useLocation();

  return (
    <header className="w-full border-b border-border-subtle bg-bg-card shadow-sm">
      {/* Changed to w-full and added lg:px-8 for nice edge spacing on big screens */}
      <div className="flex w-full items-center justify-between px-6 py-3 lg:px-8">
        {/* Logo / Project name */}
        <span className="text-brand-primary text-lg font-bold">
          {{ project_name }}
        </span>

        {/* Right side: Navigation + optional auth badge */}
        <div className="flex items-center gap-4 sm:gap-6">
          {/* Navigation */}
          <nav className="flex items-center gap-1">
            {NAV_ITEMS.map(({ to, label }) => {
              const isActive = location.pathname === to;
              return (
                <Link
                  key={to}
                  to={to}
                  className={`rounded-md px-3 py-2 text-sm font-medium transition-all duration-200 ${
                    isActive
                      ? "bg-brand-primary/10 text-brand-primary"
                      : "text-text-muted hover:bg-gray-100 hover:text-text-main"
                  }`}
                >
                  {label}
                </Link>
              );
            })}
          </nav>
{% if use_oidc %}
          <div className="bg-border-subtle hidden h-6 w-px sm:block" />
          <AuthBadge />
{% endif %}
        </div>
      </div>
    </header>
  );
}