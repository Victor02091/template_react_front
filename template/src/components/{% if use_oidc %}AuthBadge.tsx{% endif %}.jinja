import { useAuth } from "react-oidc-context";

export function AuthBadge() {
  const auth = useAuth();

  // Safely extract a display name and first initial.
  const displayName =
    auth.user?.profile.preferred_username || auth.user?.profile.name || "User";
  const initial = displayName.charAt(0).toUpperCase();

  return (
    <div className="flex items-center">
      {auth.isLoading && (
        <div className="flex animate-pulse items-center gap-2">
          <div className="h-8 w-8 rounded-full bg-gray-200" />
          <div className="hidden h-4 w-20 rounded bg-gray-200 sm:block" />
        </div>
      )}

      {auth.isAuthenticated && (
        <div className="flex items-center gap-3">
          <div className="flex items-center gap-2 rounded-full border border-border-subtle bg-gray-50 py-1 pl-1 pr-3">
            <div className="flex h-7 w-7 items-center justify-center rounded-full bg-brand-primary/10 text-xs font-bold text-brand-primary">
              {initial}
            </div>
            <span className="max-w-[120px] truncate text-sm font-medium text-text-main">
              {displayName}
            </span>
          </div>

          <button
            onClick={() => void auth.signoutRedirect()}
            className="rounded-md px-3 py-1.5 text-sm font-medium text-text-muted transition-colors hover:bg-gray-100 hover:text-text-main"
            title="Log out"
          >
            Log out
          </button>
        </div>
      )}

      {!auth.isLoading && !auth.isAuthenticated && (
        <button
          onClick={() => void auth.signinRedirect()}
          className="rounded-md bg-brand-primary px-5 py-2 text-sm font-medium text-white shadow-sm transition-all hover:opacity-90 hover:shadow"
        >
          Log in
        </button>
      )}
    </div>
  );
}
