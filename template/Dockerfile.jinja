# Stage 0: Build
FROM node:{{ node_version }}-bookworm AS build

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Build the app
COPY . .
RUN npm run build

# Stage 1: Serve with unprivileged nginx
FROM ghcr.io/nginxinc/nginx-unprivileged:1.24

# Copy Vite build output
COPY --from=build /app/dist /usr/share/nginx/html

# Copy runtime env template
COPY public/env.template.js /usr/share/nginx/html/env.template.js

# Overwrite the default Nginx config with our config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Make html folder writable for user 101
USER root
RUN chown -R 101:0 /usr/share/nginx/html
USER 101

EXPOSE 8080

# Replace env.js at container startup using envsubst
CMD ["/bin/sh", "-c", \
  "envsubst < /usr/share/nginx/html/env.template.js > /usr/share/nginx/html/env.js \
   && exec nginx -g 'daemon off;'"]
