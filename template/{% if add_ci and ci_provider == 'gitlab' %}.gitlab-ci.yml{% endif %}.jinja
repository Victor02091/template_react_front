stages:
  - quality

variables:
  NODE_VERSION: "{{ node_version }}"

lint-and-build:
  stage: quality
  image: node:${NODE_VERSION}-bookworm
  cache:
    key:
      files:
        - package-lock.json
    paths:
      - node_modules/
  before_script:
    - npm ci
  script:
    - npx tsc -b --noEmit
    - npm run lint
    - npm run build
